{
  "mappings": [
    {
      "id": "00000000-0000-0000-0018-000000000001",
      "name": "Identity Consent Validation Guard - Reject verification_consent=false",
      "priority": 4,
      "request": {
        "method": "POST",
        "urlPathPattern": "^/(merchant/)?api/v1/identities/(ng|ke|gh|za)/.*",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.verification_consent == false)]"
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "status": false,
          "message": "Customer consent is required to perform verification",
          "data": null
        }
      }
    },
    {
      "id": "00000000-0000-0000-0018-000000000002",
      "name": "Nigeria KYC - Verify BVN",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPathPattern": "^/(merchant/)?api/v1/identities/ng/bvn$",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.id"
          },
          {
            "matchesJsonPath": "$[?(@.verification_consent == true)]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"status\": true,\n  \"message\": \"BVN verified successfully\",\n  \"data\": {\n    \"reference\": \"VR-BVN-{{jsonPath request.body '$.id'}}\",\n    \"id\": \"{{jsonPath request.body '$.id'}}\",\n    \"id_type\": \"ng_bvn\",\n    \"first_name\": \"{{val (jsonPath request.body '$.first_name') default='Trevor'}}\",\n    \"last_name\": \"{{val (jsonPath request.body '$.last_name') default='Mandela'}}\",\n    \"middle_name\": \"Chukwudi\",\n    \"date_of_birth\": \"1989-07-08\",\n    \"gender\": \"male\",\n    \"phone_number\": \"08031234567\",\n    \"email\": \"trevor.mandela@kora.test\",\n    \"nationality\": \"NG\",\n    \"status\": \"verified\",\n    \"validation\": {\n      \"first_name\": { \"match\": true },\n      \"last_name\": { \"match\": true },\n      \"date_of_birth\": { \"match\": true }\n    },\n    \"facial_match\": {\n      \"confidence_score\": 96.5,\n      \"match\": true\n    }\n  }\n}"
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "VR-BVN-{{jsonPath request.body '$.id'}}",
            "state": {
              "reference": "VR-BVN-{{jsonPath request.body '$.id'}}",
              "id": "{{jsonPath request.body '$.id'}}",
              "id_type": "ng_bvn",
              "first_name": "{{val (jsonPath request.body '$.first_name') default='Trevor'}}",
              "last_name": "{{val (jsonPath request.body '$.last_name') default='Mandela'}}",
              "status": "verified",
              "createdAt": "{{now format='yyyy-MM-dd\\'T\\'HH:mm:ss\\'Z\\''}}"
            }
          }
        }
      ]
    },
    {
